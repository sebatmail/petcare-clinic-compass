[Unit]
Description=Gunicorn daemon for PetCare Veterinary System
After=network.target postgresql.service

[Service]
User=ubuntu
Group=www-data
UMask=007
WorkingDirectory=/home/ubuntu/petcare_project
Environment="USE_POSTGRES=True"
Environment="DB_NAME=petcare_db"
Environment="DB_USER=petcare_user"
Environment="DB_PASSWORD=petcare_pass_2026"
Environment="DB_HOST=localhost"
Environment="DB_PORT=5432"
Environment="DJANGO_DEBUG=False"
ExecStart=/home/ubuntu/petcare_project/venv/bin/gunicorn --workers 3 --bind unix:/home/ubuntu/petcare_project/petcare.sock petcare_core.wsgi:application
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
